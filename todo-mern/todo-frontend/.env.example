# Copy this file to .env and adjust the values for your machine.
#
#   cp .env.example .env
#
# Vite exposes any variable prefixed with VITE_ to the browser via
# import.meta.env, so keep sensitive keys OUT of this file -- anything in
# here ends up in the JavaScript bundle that users download.

# Base URL of the Express API. The frontend talks to the backend through
# this URL (see src/services/api.ts).
#
# The trailing /api matters. Routes are mounted at app.use("/api/todos", ...)
# in the backend, and every service call is written as api.get("/todos"),
# which resolves to <VITE_API_URL>/todos. Drop the /api and every request
# 404s.
#
# Keep the port in sync with the backend: this reference build listens on
# 4000, while Lessons 14-17 use 3001 as you build it up. Use whichever
# port your own backend prints on startup.
VITE_API_URL=http://localhost:4000/api
