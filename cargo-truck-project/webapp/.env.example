# Copy this file to .env.local and adjust for your machine:
#   cp .env.example .env.local
#
# Anything prefixed NEXT_PUBLIC_ is sent to the browser -- never put
# secrets here. They belong in the backend's .env.

# Base URL of the Express backend. The trailing /api matters: routes are
# mounted at /api/... on the backend, and services call api.get("/auth/me").
NEXT_PUBLIC_API_URL=http://localhost:4001/api
